<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, coverage gate, and common test packages come from src/tests/Directory.Build.props +
       Directory.Packages.props. Only this project's coverage scope + extra packages stay here. -->
  <PropertyGroup>
    <!-- 90% line-coverage gate for the host logic; the composition root (Program) is wiring-only. -->
    <Include>[Ingestion.Worker]*</Include>
    <ExcludeByFile>**/Program.cs</ExcludeByFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!-- Real production layouts, so format binding is proven to load the actual specs, not fixtures. -->
  <ItemGroup>
    <Content Include="..\..\..\docs\layouts\g266-v4.8.yaml" Link="Layouts\g266-v4.8.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\docs\layouts\force-update-balance-v1.0.yaml" Link="Layouts\force-update-balance-v1.0.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Ingestion.Worker\Ingestion.Worker.csproj" />
  </ItemGroup>

</Project>
