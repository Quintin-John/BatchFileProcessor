<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Nullable / ImplicitUsings / analyzers inherited from Directory.Build.props (DRY). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>ingestion-worker</UserSecretsId>
    <RootNamespace>Ingestion.Worker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="YamlDotNet" />
    <!-- Pin patched System.Text.Json: Microsoft.Extensions.Hosting 8.0.0 pulls 8.0.0 transitively,
         which carries GHSA-hh2w-p6rv-4g7w / GHSA-8g4q-xg66-9fp4 (High). 8.0.5 resolves both. -->
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- ASP.NET Core for the K8s liveness/readiness HTTP probe endpoints. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ingestion.Worker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common.FileIngestion\Common.FileIngestion.csproj" />
    <ProjectReference Include="..\Common.Messaging.Contracts\Common.Messaging.Contracts.csproj" />
    <ProjectReference Include="..\Common.Messaging.MassTransit\Common.Messaging.MassTransit.csproj" />
    <ProjectReference Include="..\Common.Observability\Common.Observability.csproj" />
    <ProjectReference Include="..\Common.Security.DataProtection\Common.Security.DataProtection.csproj" />
    <ProjectReference Include="..\Common.FileIngestion.Abstractions\Common.FileIngestion.Abstractions.csproj" />
    <ProjectReference Include="..\Common.FileIngestion.Layouts\Common.FileIngestion.Layouts.csproj" />
    <ProjectReference Include="..\Common.FileIngestion.Reading\Common.FileIngestion.Reading.csproj" />
    <ProjectReference Include="..\Common.FileIngestion.Sources.Folder\Common.FileIngestion.Sources.Folder.csproj" />
    <ProjectReference Include="..\Common.FileIngestion.Checkpointing\Common.FileIngestion.Checkpointing.csproj" />
    <ProjectReference Include="..\Common.FileIngestion.Parsing\Common.FileIngestion.Parsing.csproj" />
    <ProjectReference Include="..\Common.FileIngestion.Telemetry\Common.FileIngestion.Telemetry.csproj" />
    <ProjectReference Include="..\Common.FileIngestion.Protection\Common.FileIngestion.Protection.csproj" />
  </ItemGroup>

</Project>
