{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "MassTransit": "Warning"
    }
  },
  "Ingestion": {
    "ProfilesPath": "/config/profiles.yaml",
    "CheckpointProvider": "File",
    "CheckpointDirectory": "/data/checkpoints",
    "RedisConnectionString": "localhost:6379",
    "CheckpointKeyPrefix": "ingestion:watermark:",
    "BatchChannelCapacity": 32,
    "PublisherConcurrency": 4,
    "PublisherConfirmWindow": 64,
    "LivenessStalenessSeconds": 120,
    "LineageChannelCapacity": 100000
  },
  "Observability": {
    "ServiceName": "ingestion-worker",
    "ServiceVersion": "1.0.0",
    "Environment": "local",
    "SamplingRatio": 1.0
  },
  "Otlp": {
    "Endpoint": ""
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "ConnectionString": "amqp://guest:guest@localhost:5672",
    "EndpointPrefix": "ingestion",
    "Resilience": {
      "RetryLimit": 5,
      "CircuitBreakerTripThreshold": 15,
      "CircuitBreakerActiveThreshold": 10
    }
  }
}
