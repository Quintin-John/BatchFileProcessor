{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "MassTransit": "Warning"
    }
  },
  "Ingestion": {
    "RootDirectory": "/data/g266",
    "CheckpointDirectory": "/data/g266/checkpoints",
    "LayoutPath": "/config/g266-v4.8.yaml",
    "DataProtectionPolicyPath": "/config/g266-data-protection.yaml",
    "ProfileId": "g266",
    "TerminatorLength": 1,
    "MaxRecordsPerBatch": 500,
    "MaxContentBytesPerBatch": 200000,
    "PollIntervalSeconds": 5,
    "LivenessStalenessSeconds": 120,
    "LineageChannelCapacity": 100000
  },
  "Observability": {
    "ServiceName": "ingestion-worker",
    "ServiceVersion": "1.0.0",
    "Environment": "local",
    "SamplingRatio": 1.0
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "ConnectionString": "amqp://guest:guest@localhost:5672",
    "EndpointPrefix": "ingestion",
    "Resilience": {
      "RetryLimit": 5,
      "CircuitBreakerTripThreshold": 15,
      "CircuitBreakerActiveThreshold": 10
    }
  }
}
