<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared build/quality settings come from Directory.Build.props (solution root). -->
  <PropertyGroup>

    <!-- Public library: ship XML docs; keep the public surface deliberate. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <!-- Pin patched OpenTelemetry.Api: the 1.9.0 SDK pulls Api 1.9.0, which carries
         GHSA-g94r-2vxg-569j (CVE-2026-40894, propagation-header memory exhaustion; fixed in 1.15.3).
         Api is SemVer-additive within 1.x, so the 8.0.x-compatible 1.9.0 SDK binds cleanly against
         1.15.3 without forcing the Microsoft.Extensions 9.0.x uplift that OpenTelemetry 1.10+ requires. -->
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

</Project>
