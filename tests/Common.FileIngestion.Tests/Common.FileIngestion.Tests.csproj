<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, coverage gate, and common test packages come from tests/Directory.Build.props +
       Directory.Packages.props. Only this project's coverage scope stays here. -->
  <PropertyGroup>
    <Include>[Common.FileIngestion]*,[Common.FileIngestion.Abstractions]*,[Common.FileIngestion.Layouts]*,[Common.FileIngestion.Reading]*,[Common.FileIngestion.Sources.Folder]*,[Common.FileIngestion.Checkpointing]*,[Common.FileIngestion.Parsing]*,[Common.FileIngestion.Telemetry]*,[Common.FileIngestion.Protection]*</Include>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Common.FileIngestion\Common.FileIngestion.csproj" />
    <ProjectReference Include="..\..\src\Common.FileIngestion.Layouts\Common.FileIngestion.Layouts.csproj" />
    <ProjectReference Include="..\..\src\Common.FileIngestion.Reading\Common.FileIngestion.Reading.csproj" />
    <ProjectReference Include="..\..\src\Common.FileIngestion.Sources.Folder\Common.FileIngestion.Sources.Folder.csproj" />
    <ProjectReference Include="..\..\src\Common.FileIngestion.Checkpointing\Common.FileIngestion.Checkpointing.csproj" />
    <ProjectReference Include="..\..\src\Common.FileIngestion.Parsing\Common.FileIngestion.Parsing.csproj" />
    <ProjectReference Include="..\..\src\Common.FileIngestion.Telemetry\Common.FileIngestion.Telemetry.csproj" />
    <ProjectReference Include="..\..\src\Common.FileIngestion.Protection\Common.FileIngestion.Protection.csproj" />
  </ItemGroup>

  <!-- Real G266 V4.8 layout, so tests prove the generic loader accepts the actual spec. -->
  <ItemGroup>
    <Content Include="..\..\docs\layouts\g266-v4.8.yaml" Link="Layouts\g266-v4.8.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
